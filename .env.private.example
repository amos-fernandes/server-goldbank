# AIBANK Server v3.0 — variáveis de ambiente
# Copie para .env.private e preencha os valores

# ─── NECTAco (Banking Core + PIX) ─────────────────────────────────────────────
NECTA_API_KEY=sua_chave_necta_aqui
NECTA_BASE_URL=https://api.nectaco.com.br
NECTA_CLIENT_ID=seu_client_id_necta
NECTA_WEBHOOK_SECRET=segredo_webhook_necta

# ─── AZIFY (Fallback PIX Provider) ────────────────────────────────────────────
AZIFY_API_KEY=sua_chave_azify_aqui
AZIFY_BASE_URL=https://api.azify.com
AZIFY_CLIENT_ID=seu_client_id_azify
AZIFY_WEBHOOK_SECRET=segredo_webhook_azify

# ─── SEGURANÇA ────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=chave_hex_64_chars_aqui

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=chave_jwt_128_chars_aqui

# ─── GTK INTEGRATION ─────────────────────────────────────────────────────────
GTK_API_URL=https://gtk-api-529742420922.southamerica-east1.run.app
GTK_API_KEY=gtk_api_key_prod_2026_a1b2c3d4e5

# ─── ETHEREUM (para transferências GTK) ───────────────────────────────────────
ETH_RPC_URL=https://eth.llamarpc.com
GTK_TOKEN_ADDRESS=0x8751264B0f82cfE5DD3ad941b4d28FD7a0f896EA

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Dev: http://localhost:8081,exp://localhost:8081
# Prod: https://app.aibank.com.br
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081,http://localhost:19006,http://localhost:3000

# ─── BANCO DE DADOS (PostgreSQL) ─────────────────────────────────────────────
# Render: cole aqui a "Internal Database URL" do seu PostgreSQL
# Se não configurado, usa memória in-memory (dev/demo)
DATABASE_URL=postgresql://usuario:senha@host:5432/aibank

# ─── SERVIDOR ─────────────────────────────────────────────────────────────────
PORT=8082
NODE_ENV=development
