# AIBANK Server — variáveis de ambiente
# Render: Environment → adicione as variáveis (não commite segredos)

# ─── MODO DEMO (sem Necta/Azify) ─────────────────────────────────────────────
# true = PIX/KYC/customer mock; conta demo@aibank.com.br
# Também ativa automaticamente se NECTA_API_KEY e AZIFY_API_KEY estiverem vazias
DEMO_MODE=true

# ─── NECTAco (desligado em DEMO_MODE) ────────────────────────────────────────
# NECTA_API_KEY=
# NECTA_BASE_URL=https://api.nectaco.com.br
# NECTA_CLIENT_ID=
# NECTA_WEBHOOK_SECRET=

# ─── AZIFY (desligado em DEMO_MODE) ──────────────────────────────────────────
# AZIFY_API_KEY=
# AZIFY_BASE_URL=https://api.azify.com
# AZIFY_CLIENT_ID=
# AZIFY_WEBHOOK_SECRET=

# ─── SEGURANÇA ───────────────────────────────────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
JWT_SECRET=

# ─── GTK (opcional) ──────────────────────────────────────────────────────────
GTK_API_URL=https://gtk-api-529742420922.southamerica-east1.run.app
GTK_API_KEY=

ETH_RPC_URL=https://eth.llamarpc.com
GTK_TOKEN_ADDRESS=0x8751264B0f82cfE5DD3ad941b4d28FD7a0f896EA

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://server-goldbank.onrender.com,http://localhost:8081,exp://localhost:8081,http://localhost:19006,http://localhost:3000

# ─── BANCO (opcional — sem isso usa memória) ─────────────────────────────────
# DATABASE_URL=

PORT=8082
NODE_ENV=production
